{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maple.local/schemas/host-event.schema.json",
  "title": "Maple host events v2",
  "$defs": {
    "schemaVersion": { "const": 2 },
    "timestamp": { "type": "string", "format": "date-time" },
    "sessionState": { "enum": ["Stopped", "Arming", "Observing", "MapScanning", "MapCalibrating", "Navigating", "Attacking", "Looting", "UsingPotion", "Paused", "ManualIntervention", "EmergencyStop"] },
    "pauseReason": { "enum": ["None", "CalibrationRequired", "StaleFrame", "TargetLost", "WindowNotForeground", "BlackFrame", "MapNotValidated", "InputUnavailable", "HealthUnknown", "UnknownPopup", "WatchdogTimeout", "OperatorRequested", "SafetyViolation"] },
    "inferenceProvider": { "enum": ["none", "cpu", "directml", "cuda"] },
    "captureBackend": { "enum": ["WGC", "BitBlt", "PrintWindow"] },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "telemetry.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "timestamp", "captureFps", "renderFps", "recognitionFps", "frameLatencyMs", "detectorLatencyMs", "droppedFrames", "queueAgeMs", "processMemoryMb", "inferenceProvider", "captureBackend", "lastAction", "warningCode", "state", "pauseReason"],
          "properties": {
            "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
            "timestamp": { "$ref": "#/$defs/timestamp" },
            "captureFps": { "type": "number", "minimum": 0 },
            "renderFps": { "type": "number", "minimum": 0 },
            "recognitionFps": { "type": "number", "minimum": 0 },
            "frameLatencyMs": { "type": "number", "minimum": 0 },
            "detectorLatencyMs": { "type": "number", "minimum": 0 },
            "droppedFrames": { "type": "integer", "minimum": 0 },
            "queueAgeMs": { "type": "number", "minimum": 0 },
            "processMemoryMb": { "type": "number", "minimum": 0 },
            "inferenceProvider": { "$ref": "#/$defs/inferenceProvider" },
            "captureBackend": { "$ref": "#/$defs/captureBackend" },
            "lastAction": { "type": ["string", "null"], "maxLength": 128 },
            "warningCode": { "type": ["string", "null"], "maxLength": 128 },
            "state": { "$ref": "#/$defs/sessionState" },
            "pauseReason": { "$ref": "#/$defs/pauseReason" }
          }
        }
      }
    },
    "visionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "vision.status.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "modelId", "provider", "diagnostic"],
          "properties": {
            "status": { "enum": ["notConfigured", "inspecting", "ready", "repairing", "faulted"] },
            "modelId": { "type": ["string", "null"], "maxLength": 128 },
            "provider": { "$ref": "#/$defs/inferenceProvider" },
            "diagnostic": { "type": ["string", "null"], "maxLength": 128 }
          }
        }
      }
    },
    "combatConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "config.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "attackMode", "hpThresholdMode", "hpThreshold", "mpThresholdMode", "mpThreshold", "singleAttackKey", "areaAttackKey", "hpPotionKey", "mpPotionKey", "jumpKey", "pickupEnabled", "pickupKey", "preferredDistancePx", "areaTargetCount", "switchCooldownMs"],
          "properties": {
            "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
            "attackMode": { "enum": ["single", "auto", "group"] },
            "hpThresholdMode": { "enum": ["percent", "absolute"] },
            "hpThreshold": { "type": "number", "minimum": 0 },
            "mpThresholdMode": { "enum": ["percent", "absolute"] },
            "mpThreshold": { "type": "number", "minimum": 0 },
            "singleAttackKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "areaAttackKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "hpPotionKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "mpPotionKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "jumpKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "pickupEnabled": { "type": "boolean" },
            "pickupKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "preferredDistancePx": { "type": "integer", "minimum": 20, "maximum": 500 },
            "areaTargetCount": { "type": "integer", "minimum": 2, "maximum": 20 },
            "switchCooldownMs": { "type": "integer", "minimum": 100, "maximum": 10000 }
          },
          "allOf": [
            { "if": { "properties": { "hpThresholdMode": { "const": "percent" } } }, "then": { "properties": { "hpThreshold": { "maximum": 100 } } } },
            { "if": { "properties": { "mpThresholdMode": { "const": "percent" } } }, "then": { "properties": { "mpThreshold": { "maximum": 100 } } } }
          ]
        }
      }
    },
    "mapRuntimeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "map.status.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapId", "state", "coverage", "calibrationErrorPx", "platformCount", "ladderCount", "errors", "canProduceActions"],
          "properties": {
            "mapId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "state": { "enum": ["candidate", "validated", "archived"] },
            "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "calibrationErrorPx": { "type": "number", "minimum": 0 },
            "platformCount": { "type": "integer", "minimum": 0 },
            "ladderCount": { "type": "integer", "minimum": 0 },
            "errors": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
            "canProduceActions": { "type": "boolean" }
          }
        }
      }
    },
    "mapScanStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "map.scan.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["scanning", "frameIds"], "properties": { "scanning": { "type": "boolean" }, "frameIds": { "type": "array", "maxItems": 256, "items": { "type": "integer", "minimum": 0 } } } }
      }
    },
    "inputBrokerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "input.status.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "status", "integrity", "activeKeys", "lastReleaseSucceeded", "hotkeys", "errorCode"],
          "properties": {
            "provider": { "const": "inputBroker" },
            "status": { "enum": ["disconnected", "starting", "ready", "paused", "faulted"] },
            "integrity": { "enum": ["unknown", "medium", "high"] },
            "activeKeys": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
            "lastReleaseSucceeded": { "type": "boolean" },
            "hotkeys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pauseResume", "emergencyStop"],
              "properties": {
                "pauseResume": { "enum": ["F9", "Ctrl+Shift+F9"] },
                "emergencyStop": { "enum": ["F12", "Ctrl+Shift+F12"] }
              }
            },
            "errorCode": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "cloudStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "cloud.status.updated" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "enabled", "credentialConfigured", "modelId", "connectionStatus", "requestInFlight", "lastErrorCode"],
          "properties": {
            "provider": { "const": "bailian" },
            "enabled": { "type": "boolean" },
            "credentialConfigured": { "type": "boolean" },
            "modelId": { "enum": ["qwen3-vl-plus", "qwen3-vl-flash", "qwen-vl-max"] },
            "connectionStatus": { "enum": ["notConfigured", "checking", "ready", "unavailable"] },
            "requestInFlight": { "type": "boolean" },
            "lastErrorCode": { "type": ["string", "null"], "maxLength": 64 }
          }
        }
      }
    },
    "existingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "enum": ["target.updated", "capture.frameMetadata", "overlay.updated", "observation.updated", "session.stateChanged", "input.result", "log.appended", "preview.availabilityChanged"] },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/telemetry" },
    { "$ref": "#/$defs/visionStatus" },
    { "$ref": "#/$defs/combatConfiguration" },
    { "$ref": "#/$defs/mapRuntimeStatus" },
    { "$ref": "#/$defs/mapScanStatus" },
    { "$ref": "#/$defs/inputBrokerStatus" },
    { "$ref": "#/$defs/cloudStatus" },
    { "$ref": "#/$defs/existingEvent" }
  ]
}
