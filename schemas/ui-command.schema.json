{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maple.local/schemas/ui-command.schema.json",
  "title": "Maple UI commands v2",
  "$defs": {
    "schemaVersion": { "const": 2 },
    "timestamp": { "type": "string", "format": "date-time" },
    "emptyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "enum": ["snapshot.request", "session.arm", "session.pause", "session.resume", "combat.trial.start", "map.scan.start", "map.calibration.start", "cloud.credential.clear", "cloud.connection.test"] },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object", "additionalProperties": false }
      }
    },
    "stationaryAttack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "stationary.attack.set" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "mapCalibrationConfirm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "map.calibration.confirm" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["mapId"], "properties": { "mapId": { "type": "string", "minLength": 1, "maxLength": 256 } } }
      }
    },
    "previewBoundsChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "preview.boundsChanged" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "width", "height", "devicePixelRatio"],
          "properties": {
            "left": { "type": "number", "minimum": 0, "maximum": 10000 },
            "top": { "type": "number", "minimum": 0, "maximum": 10000 },
            "width": { "type": "number", "minimum": 320, "maximum": 10000 },
            "height": { "type": "number", "minimum": 180, "maximum": 10000 },
            "devicePixelRatio": { "type": "number", "minimum": 0.5, "maximum": 4 }
          }
        }
      }
    },
    "inputTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "input.test" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "holdMs"],
          "properties": {
            "kind": { "enum": ["moveLeft", "moveRight", "climbUp", "climbDown", "jump", "attack", "pickup", "hpPotion", "mpPotion"] },
            "holdMs": { "type": "integer", "minimum": 50, "maximum": 600 }
          }
        }
      }
    },
    "emergencyStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "session.emergencyStop" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 200 } } }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "config.update" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attackMode": { "enum": ["single", "auto", "group"] },
            "hpThresholdMode": { "enum": ["percent", "absolute"] },
            "hpThreshold": { "type": "number", "minimum": 0 },
            "mpThresholdMode": { "enum": ["percent", "absolute"] },
            "mpThreshold": { "type": "number", "minimum": 0 },
            "attackKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "singleAttackKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "areaAttackKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "hpPotionKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "mpPotionKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "jumpKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "pickupEnabled": { "type": "boolean" },
            "pickupKey": { "type": "string", "minLength": 1, "maxLength": 32 },
            "preferredDistancePx": { "type": "integer", "minimum": 20, "maximum": 500 },
            "areaTargetCount": { "type": "integer", "minimum": 2, "maximum": 20 },
            "switchCooldownMs": { "type": "integer", "minimum": 100, "maximum": 10000 }
          },
          "allOf": [
            { "if": { "properties": { "hpThresholdMode": { "const": "percent" } }, "required": ["hpThresholdMode"] }, "then": { "properties": { "hpThreshold": { "maximum": 100 } } } },
            { "if": { "properties": { "mpThresholdMode": { "const": "percent" } }, "required": ["mpThresholdMode"] }, "then": { "properties": { "mpThreshold": { "maximum": 100 } } } }
          ]
        }
      }
    },
    "cloudCredentialSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "cloud.credential.set" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["apiKey"], "properties": { "apiKey": { "type": "string", "minLength": 16, "maxLength": 256, "pattern": "^\\S+$" } } }
      }
    },
    "cloudConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "cloud.config.update" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "modelId", "uploadConsent"],
          "properties": {
            "enabled": { "type": "boolean" },
            "modelId": { "enum": ["qwen3-vl-plus", "qwen3-vl-flash", "qwen-vl-max"] },
            "uploadConsent": { "type": "boolean" }
          }
        }
      }
    },
    "cloudMapAnnotate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "cloud.map.annotate" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapId", "sourceFrameIds"],
          "properties": {
            "mapId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "sourceFrameIds": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/emptyCommand" },
    { "$ref": "#/$defs/stationaryAttack" },
    { "$ref": "#/$defs/previewBoundsChanged" },
    { "$ref": "#/$defs/inputTest" },
    { "$ref": "#/$defs/emergencyStop" },
    { "$ref": "#/$defs/mapCalibrationConfirm" },
    { "$ref": "#/$defs/configuration" },
    { "$ref": "#/$defs/cloudCredentialSet" },
    { "$ref": "#/$defs/cloudConfig" },
    { "$ref": "#/$defs/cloudMapAnnotate" }
  ]
}
