<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Maple.Host</RootNamespace>
    <AssemblyName>Maple</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3277;CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Maple.Contracts/Maple.Contracts.csproj" />
    <ProjectReference Include="../Maple.Core/Maple.Core.csproj" />
    <ProjectReference Include="../Maple.Runtime/Maple.Runtime.csproj" />
    <ProjectReference Include="../Maple.Input/Maple.Input.csproj" />
    <ProjectReference Include="../Maple.Map/Maple.Map.csproj" />
    <ProjectReference Include="../Maple.Capture/Maple.Capture.csproj" />
    <ProjectReference Include="../Maple.Vision/Maple.Vision.csproj" />
    <ProjectReference Include="../Maple.Preview/Maple.Preview.csproj" />
    <ProjectReference Include="../Maple.Cloud/Maple.Cloud.csproj" />
    <ProjectReference Include="../Maple.InputBroker/Maple.InputBroker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\ui\dist\index.html')">
    <Content Include="..\..\ui\dist\**\*"
             Link="ui\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\assets\tessdata\eng.traineddata')">
    <Content Include="..\..\assets\tessdata\eng.traineddata"
             Link="tessdata\eng.traineddata"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateReactAssets" BeforeTargets="Publish">
    <Error Condition="!Exists('..\..\ui\dist\index.html')"
           Text="React assets are missing. Run tools/build-react-ui.ps1 before publishing." />
  </Target>
  <Target Name="CopyInputBrokerArtifacts" AfterTargets="Build">
    <ItemGroup>
      <InputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.exe" />
      <InputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.dll" />
      <InputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.deps.json" />
      <InputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(InputBrokerArtifacts)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(InputBrokerArtifacts.Identity)')" />
  </Target>
  <Target Name="CopyInputBrokerArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedInputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.exe" />
      <PublishedInputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.dll" />
      <PublishedInputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.deps.json" />
      <PublishedInputBrokerArtifacts Include="..\Maple.InputBroker\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Maple.InputBroker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedInputBrokerArtifacts)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(PublishedInputBrokerArtifacts.Identity)')" />
  </Target>
</Project>
