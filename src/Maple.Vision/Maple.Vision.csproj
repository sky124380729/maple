<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Maple.Vision</RootNamespace>
    <AssemblyName>Maple.Vision</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Maple.Contracts/Maple.Contracts.csproj" />
    <ProjectReference Include="../Maple.Capture/Maple.Capture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" ExcludeAssets="analyzers" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" Condition="$([MSBuild]::IsOSPlatform('Windows'))" ExcludeAssets="analyzers" />
    <PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.osx-arm64" Version="4.13.0.45" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
  <PropertyGroup><NoWarn>$(NoWarn);CS9057</NoWarn></PropertyGroup>
</Project>
