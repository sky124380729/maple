[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderName%
DriverVer=08/14/2026,1.0.0.0
CatalogFile=MapleVhfKeyboard.cat
PnpLockdown=1

[DestinationDirs]
MapleVhfKeyboard.CopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
MapleVhfKeyboard.sys=1

[Manufacturer]
%ProviderName%=Maple,NT$ARCH$.10.0...19041

[Maple.NT$ARCH$.10.0...19041]
%DeviceDescription%=MapleVhfKeyboard.Install,Root\MapleVhfKeyboard

[MapleVhfKeyboard.Install.NT]
CopyFiles=MapleVhfKeyboard.CopyFiles

[MapleVhfKeyboard.CopyFiles]
MapleVhfKeyboard.sys

[MapleVhfKeyboard.Install.NT.HW]
AddReg=MapleVhfKeyboard.LowerFilter

[MapleVhfKeyboard.LowerFilter]
HKR,,LowerFilters,0x00010000,"vhf"

[MapleVhfKeyboard.Install.NT.Services]
AddService=MapleVhfKeyboard,0x00000002,MapleVhfKeyboard.Service

[MapleVhfKeyboard.Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\MapleVhfKeyboard.sys

[MapleVhfKeyboard.Install.NT.Wdf]
KmdfService=MapleVhfKeyboard,MapleVhfKeyboard.Wdf

[MapleVhfKeyboard.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="Maple Project"
DeviceDescription="Maple VHF Keyboard"
ServiceDescription="Maple VHF Keyboard Service"
DiskName="Maple VHF Keyboard Driver Disk"
DeviceInterfaceGuid="{6E6E6F4A-21A5-4DD2-86E5-7DB4C7E8A101}"
